{
  "name": "nmtaskboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "牛马任务看板 — 专为记不住事儿的打工牛马：记录工作待办、AI 智能建任务、生成工作周报",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:client": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "test": "node --test test/*.test.js test/helpers.js test/llm-stub.js",
    "test:persistence:json": "node --test test/persistence-json.test.js",
    "test:persistence:postgres": "REQUIRE_POSTGRES_TEST=1 node --test test/persistence-postgres.test.js",
    "test:client": "vitest run --config vite.config.js",
    "check": "npm test && npm run test:client && npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "express": "^4.21.2",
    "motion": "^13.1.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
